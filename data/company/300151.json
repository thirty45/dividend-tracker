, "price": 5.9, "amount": 7546690.0, "reason": "大宗交易", "after": 25115900.0, "relation": "本人"}, {"date": "2019-06-26", "name": "徐燕平", "title": "董事,高管", "direction": "减持", "shares": -1180000.0, "price": 5.92, "amount": 6985600.0, "reason": "大宗交易", "after": 26395000.0, "relation": "本人"}, {"date": "2019-06-21", "name": "俞汉昌", "title": "监事", "direction": "减持", "shares": -40000.0, "price": 6.58, "amount": 263200.0, "reason": "竞价交易", "after": 197000.0, "relation": "本人"}, {"date": "2019-06-06", "name": "华守夫", "title": "董事,高管", "direction": "减持", "shares": -928400.0, "price": 5.37, "amount": 4985508.0, "reason": "大宗交易", "after": 23187500.0, "relation": "本人"}, {"date": "2019-06-04", "name": "华守夫", "title": "董事,高管", "direction": "减持", "shares": -1000000.0, "price": 5.45, "amount": 5450000.0, "reason": "大宗交易", "after": 24115900.0, "relation": "本人"}], "profile": {"org_name": "深圳市昌红科技股份有限公司", "org_name_en": "SHENZHEN CHANGHONG TECHNOLOGY Co.,Ltd.", "chairman": "李焕昌", "legal_person": "李焕昌", "president": "李焕昌", "secretary": "刘力", "industry": "机械设备-通用设备-其他通用机械", "listing": "深交所创业板A股", "address": "深圳市坪山区碧岭街道沙湖社区锦龙大道3号昌红科技公司1层至3层", "reg_address": "深圳市坪山区碧岭街道沙湖社区锦龙大道3号昌红科技公司1层至3层", "emp_num": 2419.0, "business_scope": "一般经营项目是:非金属制品模具设计;经营贸易和进出口业务(法律、行政法规、国务院决定禁止的项目除外,限制的项目须取得许可后方可经营);模具技术咨询及技术服务;设备与房屋租赁(不含金融租赁业务及其他限制项目);熔喷布的研发与销售。许可经营项目是:非金属制品模具加工、制造;塑料制品、模具、五金制造(以上项目不含限制项目);消费性电子产品的生产加工;熔喷布的生产。", "profile": "深圳市昌红科技股份有限公司创于2001年,2010年在深交所创业板上市。在国内医疗器械及高分子塑料耗材及办公自动化(OA)研发及生产领域占有领先地位。昌红科技致力于为全球客户提供从设计、研发、制造、服务一体化的整体解决方案。昌红科技在医疗器械及高分子塑料耗材、半导体器件专用设备、办公自动化(OA)领域的技术能力已能够与国际巨头公司并肩。昌红科技总部设立在深圳市坪山区,公司以13家分支机构为依托,同步辐射越南、菲律宾等地,形成海内外集团化的产业布局。昌红科技依托卓越的工程技术、定制的自动化生产工艺、领先的精密模具成型周期指标、快速完备的售后服务机制,在医疗器械领域、半导体器件专用设备领域、OA自动化领域均产生了有效的融合,公司已发展成为具有“一站式”服务能力的产品供应商,已与多家行业头部企业展开了持续性的战略合作,产品畅销全球50多个国家和地区。昌红科技目前拥有国际领先的全自动高端医用耗材、试剂、仪器生产流水线、净化设施和灭菌设备。", "website": "www.sz-changhong.com"}}