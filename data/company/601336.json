e": "2026-03-31"}}, {"key": "LD", "name": "流动比率", "unit": "", "annual": {"v": null, "yoy": null, "date": "2025-12-31"}, "half": {"v": null, "yoy": null, "date": "2025-06-30"}, "quarter": {"v": null, "yoy": null, "date": "2026-03-31"}}, {"key": "SD", "name": "速动比率", "unit": "", "annual": {"v": null, "yoy": null, "date": "2025-12-31"}, "half": {"v": null, "yoy": null, "date": "2025-06-30"}, "quarter": {"v": null, "yoy": null, "date": "2026-03-31"}}]}}, "executives": [{"date": "2012-12-17", "name": "朱南松", "title": "监事", "direction": "增持", "shares": 4350000.0, "price": 21.29, "amount": 92611500.0, "reason": "二级市场买卖", "after": 4350000.0, "relation": "本人"}], "profile": {"org_name": "新华人寿保险股份有限公司", "org_name_en": "New China Life Insurance Company Ltd.", "chairman": "杨玉成", "legal_person": "杨玉成", "president": "龚兴峰", "secretary": "刘智勇", "industry": "金融-非银行金融-保险", "listing": "上交所主板A股", "address": "中国北京市朝阳区建国门外大街甲12号新华保险大厦", "reg_address": "中国北京市延庆区湖南东路16号(中关村延庆园)", "emp_num": 27726.0, "business_scope": "人民币、外币的人身保险(包括各类人寿保险、健康保险、意外伤害保险);为境内外的保险机构代理保险、检验、理赔等业务;保险咨询;依照有关法规从事资金运用业务;经保险监管机构批准的其他业务。", "profile": "新华人寿保险股份有限公司(以下简称“新华保险”或“公司”)成立于1996年9月,总部位于北京市,是一家全国性的大型寿险企业。公司锚定“中国一流的以保险业务为核心的金融服务集团”发展愿景,为客户提供覆盖全生命周期的风险保障和财富规划的产品及服务,着力推动养老产业、健康产业发展,助力寿险主业发展。2011年,新华保险在上交所和联交所同步上市。新华保险坚定不移走内涵式、高质量发展道路,深入践行“以客户为中心”的经营管理理念,持续推进各领域专业化、市场化、体系化改革转型,紧抓行业新机遇新变化,与时俱进树立大保险观,围绕客户全生命周期需求打造多层次产品体系,构建涵盖医康养等十大领域的服务生态,打造一流的投资管理能力,全面提升公司核心竞争力,推动公司实现高质量、高水平和高能级发展。", "website": "www.newchinalife.com"}}