, {"date": "2024-02-20", "name": "王羊娃", "title": "董事", "direction": "增持", "shares": 20000.0, "price": 12.68, "amount": 253600.0, "reason": "二级市场买卖", "after": 56800.0, "relation": "本人"}, {"date": "2024-02-01", "name": "张建国", "title": "董事", "direction": "增持", "shares": 2000.0, "price": 11.41, "amount": 22820.0, "reason": "二级市场买卖", "after": 20000.0, "relation": "本人"}, {"date": "2021-11-02", "name": "许尽峰", "title": "高级管理人员", "direction": "增持", "shares": 2100.0, "price": 8.347, "amount": 17528.7, "reason": "二级市场买卖", "after": 33100.0, "relation": "本人"}, {"date": "2021-11-01", "name": "许尽峰", "title": "高级管理人员", "direction": "增持", "shares": 31000.0, "price": 8.38, "amount": 259780.0, "reason": "二级市场买卖", "after": 31000.0, "relation": "本人"}, {"date": "2021-09-22", "name": "王新义", "title": "董事,高级管理人员", "direction": "增持", "shares": 14400.0, "price": 11.4, "amount": 164160.0, "reason": "二级市场买卖", "after": 14400.0, "relation": "本人"}, {"date": "2018-06-01", "name": "王启山", "title": "董事", "direction": "增持", "shares": 10000.0, "price": 4.2, "amount": 42000.0, "reason": "二级市场买卖", "after": 10000.0, "relation": "本人"}], "profile": {"org_name": "平顶山天安煤业股份有限公司", "org_name_en": "Pingdingshan Tianan Coal Mining Co., Ltd.", "chairman": "焦振营", "legal_person": "焦振营", "president": "张国川", "secretary": "刘金祥", "industry": "化石能源-煤炭-煤炭开采洗选", "listing": "上交所主板A股", "address": "河南省平顶山市矿工中路21号", "reg_address": "河南省平顶山市矿工中路21号", "emp_num": 41360.0, "business_scope": "煤炭开采,煤炭洗选及深加工,煤炭销售;道路货物运输;机械设备制造、修理;电器机械修理;金属材料、建筑材料、矿用物资、橡胶制品的销售;自来水生产、自来水管道安装、维修;零售:车用乙醇汽油、柴油、润滑油(限分支机构凭证经营);工程测量、地籍测绘;固体矿产勘查:乙级;地质钻探:乙级;设备租赁,工矿配件零售;电子产品、通讯器材(不含无线)的销售;供电、售电;电能的输送与分配;电力工程施工及通讯工程施工;能源技术服务;节能技术推广、开发、咨询、交流、转让服务;电力工程项目设计、维护、管理和经营;电力设备、机电设备、通信设备、五金工具、电料批发销售;技术研发、技术服务、技术咨询。", "profile": "平顶山天安煤业股份有限公司是由原平煤集团作为主发起人,联合河南省平顶山市中原(集团)有限公司、河南省平禹铁路有限责任公司、河南省朝川矿务局(现已更名为“平顶山天安煤业股份有限公司朝川矿”)、平顶山制革厂、煤炭工业部选煤设计研究院(现已更名为“煤炭工业平顶山选煤设计研究院有限公司”)共同发起设立的股份有限公司。公司于1998年3月17日在河南省工商行政管理局注册成立。2006年11月23日,公司股票在上海证券交易所挂牌交易,股票简称“平煤天安”(后更名为“平煤股份”),股票代码601666。公司自成立以来,奉行用户至上的经营宗旨,坚持质量为本、信誉第一,遵循互惠互利、共同发展的经营原则,生产经营稳健,安全状况良好,得到了社会各界的广泛认同,目前为上证380、中证500、MSCI指数样本股。截至2022年12月31日,控股股东为中国平煤神马控股集团有限公司,实际控制人为河南省国资委。公司主营业务为煤炭开采、煤炭洗选加工和销售。下属生产单位包括14个生产矿井和4个精煤选煤厂。公司位于国家大型煤炭基地——平顶山矿区,资源量近30亿吨,是中南地区最大的炼焦煤生产基地。煤种以主焦煤、1/3焦煤、肥煤为主,属低灰、低磷、低硫、中高挥发分、高发热量煤类。近年来,平煤股份大力实施精煤战略提质增效、四项工程进位争先、主辅分离减员降本、智能矿山安全高效,建设设备高端、管理先进、效率领先、效益一流的现代化企业,积极回报股东和社会。", "website": "www.pmta.com.cn"}}