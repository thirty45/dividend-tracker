fter": 146935087.0, "relation": "本人"}, {"date": "2012-05-23", "name": "史济平", "title": "董事,高管", "direction": "增持", "shares": 65000.0, "price": 6.7, "amount": 435500.0, "reason": "竞价交易", "after": 160000.0, "relation": "本人"}, {"date": "2012-05-22", "name": "史济平", "title": "董事,高管", "direction": "增持", "shares": 95000.0, "price": 6.64, "amount": 630800.0, "reason": "竞价交易", "after": 95000.0, "relation": "本人"}, {"date": "2012-05-22", "name": "邵海建", "title": "董事", "direction": "增持", "shares": 136200.0, "price": 6.65, "amount": 905730.0, "reason": "竞价交易", "after": 136200.0, "relation": "本人"}], "profile": {"org_name": "上海新朋实业股份有限公司", "org_name_en": "Shanghai Xinpeng Industry Co., Ltd.", "chairman": "宋琳", "legal_person": "宋琳", "president": "沈晓青", "secretary": "李文君", "industry": "交运设备-汽车-汽车零部件", "listing": "深交所主板A股", "address": "上海市青浦区华新镇华隆路1698号", "reg_address": "上海市青浦区华新镇华隆路1698号", "emp_num": 870.0, "business_scope": "一般项目:汽车零部件及配件制造;机械零件、零部件加工;非居住房地产租赁;机械设备租赁;信息咨询服务(不含许可类信息咨询服务);半导体器件专用设备销售;集成电路销售;技术服务、技术开发、技术咨询、技术交流、技术转让、技术推广。(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)", "profile": "上海新朋实业股份有限公司(简称“新朋股份”)系深圳证券交易所主板上市公司,股票代码:002328。公司总部位于上海市青浦区,并在上海(青浦区、临港新区)、苏州、宁波、长沙、扬州等地设有制造基地,同时公司在泰国也设立了海外生产基地,并在美国、香港设立子公司,客户遍布全球。公司业务领域主要涉及制造、投资两大领域,其中制造业务为汽车零部件业务和金属及通信零部件业务,产品可广泛应用于汽车零部件、数据中心、通信领域、储能领域等。公司投资业务以医疗医药、集成电路、新材料等新兴产业领域为主,目前共参与设立8支基金。公司的汽车零部件业务服务于冲压、焊接、开卷等,拥有8100T、7700T两条德国舒勒自动化冲压生产线、2条法格开卷落料线、1条舒勒开卷落料线、焊接拥有发那科、库卡等自动化焊接设备。金属及通信零部件领域拥有钣金设计和制造、模具设计及加工、精密及连续冲压、粉末喷涂、组装等加工能力,产品为数据中心机柜、液冷机柜、储能柜、智能电柜等,可用于机房、能源及通信等多个领域。", "website": "www.xinpeng.com"}}