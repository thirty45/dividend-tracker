tle": "高级管理人员", "direction": "增持", "shares": 900000.0, "price": 4.126, "amount": 3713400.0, "reason": "股权激励实施", "after": 1200000.0, "relation": "本人"}, {"date": "2023-09-28", "name": "赵欣", "title": "高级管理人员", "direction": "增持", "shares": 34500.0, "price": 23.0, "amount": 793500.0, "reason": "股权激励实施", "after": 356500.0, "relation": "本人"}, {"date": "2023-09-19", "name": "凡孝金", "title": "高级管理人员", "direction": "增持", "shares": 46000.0, "price": 23.0, "amount": 1058000.0, "reason": "股权激励实施", "after": 46000.0, "relation": "本人"}, {"date": "2023-09-19", "name": "刘淼", "title": "高级管理人员", "direction": "增持", "shares": 50600.0, "price": 23.0, "amount": 1163800.0, "reason": "股权激励实施", "after": 50600.0, "relation": "本人"}, {"date": "2023-05-26", "name": "陶运峰", "title": "高级管理人员", "direction": "增持", "shares": 300000.0, "price": 3.963, "amount": 1188900.0, "reason": "股权激励实施", "after": 300000.0, "relation": "本人"}, {"date": "2023-01-18", "name": "赵欣", "title": "高级管理人员", "direction": "增持", "shares": 72000.0, "price": 3.49, "amount": 251280.0, "reason": "股权激励实施", "after": 322000.0, "relation": "本人"}, {"date": "2023-01-18", "name": "沈涛", "title": "高级管理人员", "direction": "增持", "shares": 95000.0, "price": 4.0, "amount": 380000.0, "reason": "股权激励实施", "after": 95000.0, "relation": "本人"}], "profile": {"org_name": "九号有限公司", "org_name_en": "Ninebot Limited", "chairman": "高禄峰", "legal_person": "高禄峰", "president": "陈中元", "secretary": "徐鹏", "industry": "交运设备-其他交运设备-其他交运设备", "listing": "上交所科创板中国存托凭证", "address": "北京市海淀区西小口路66号中关村东升科技园A4号楼", "reg_address": "Maples Corporate Services Limited at PO Box 309, Ugland House, Grand Cayman, KY1-1104,Cayman Islands", "emp_num": 6995.0, "business_scope": "设计、研究、开发、生产和销售电动平衡车和电动滑板车等产品及相关配件,并提供售后服务;进出口贸易、批发、销售机器人及相关配件;计算机软件技术开发,技术转让;摩托车、电动两轮摩托车、电动正三轮摩托车、电动自行车及零部件、蓄电池、充电器及零部件的研发、加工、销售;全地形车及零部件、蓄电池、充电器及零部件的研发、加工、销售;并提供售后服务光电一体化技术开发及技术转让等。", "profile": "九号有限公司(赛格威-纳恩博Segway-Ninebot)是全球电动个人出行产品、动力运动和家庭机器人领域的领军者,专注于以用户为中心的产品技术和体验创新,提供多个品类的个人出行和家庭服务机器人产品系列。1999年,赛格威在新罕布什尔州贝德福德成立,成为自平衡交通工具和电动滑板车领域的先驱;Ninebot于2012年在中国北京创立,专注于机器人和个人出行领域的探索与创新。2015年,两家公司进行了战略合并,诞生了九号公司(赛格威-纳恩博),成为一家业务遍布多个大洲的国际化企业。目前,九号公司在北京、达拉斯、南加州、常州、阿姆斯特丹、巴黎、巴塞罗那、科隆和新加坡均设有区域总部。公司一直在自平衡车辆、电动滑板车、电动踏板车和Ebike等领域推动前沿创新,在共享电动滑板车、电动自行车、动力运动车辆和个人机器人领域树立了创新标杆或行业领导地位。2020年10月29日,九号公司在科创板成功上市(证券简称:九号公司,代码:689009),成为中国境内上市企业中“VIE+CDR第一股”。2022年7月5日,九号公司正式宣布易烊千玺成为旗下创新时尚出行品牌——Ninebot九号(简称“九号”)品牌全球代言人。公司秉承“简化人和物的移动,让生活更加便捷和有趣”(SimplyMoving)的使命,致力于通过前沿的机器人技术和电力驱动技术简化个人出行,并持续开发业界领先的产品和服务来为用户提供一流的体验。同时,九号公司更致力于持续创造和改进其先进电驱动和混动驱动技术,期待和用户一起,为世界创造一个更绿色可持续的未来。", "website": "www.ninebot.com"}}